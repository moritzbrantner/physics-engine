  "target": "x86_64-unknown-linux-gnu",
  "command": "cargo run --release --locked --example rotating_interval_work",
  "protocol": {
    "trials": 3,
    "warmup_calls": 64,
    "timed_calls": 256,
    "substeps": 4,
    "angular_damping_milli": 1000,
    "order": "alternating paired control and atomic trials",
    "control": "same build, four ordinary step(1,240) calls, collecting the same reports",
    "candidate": "same build, one advance_interval(1/60,4) call",
    "timing_boundary": "complete public engine call(s), including returned reports and transaction preparation/commit; excludes scene construction, explicit test-world clone, parity checks and ECS conversion/writeback",
    "parity": "final full rigid body state, per-body sleeping state and complete final substep reports, checked outside timing",
    "memory_scope": "journal entry counts only; excludes tree/allocator overhead, fixed-geometry cache, solver scratch and RSS",
    "sampling_limits": "three advisory native trials; sub-microsecond parked timings and low-single-digit changes are not claims of a consumer speedup"
  },
