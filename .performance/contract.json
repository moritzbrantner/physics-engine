  "operations": [
    {
      "id": "ray-first",
      "description": "World::cast_ray_first, short rays in a town of unit boxes on a 2 m grid (constant density); 64 queries per point, per-query averages.",
      "publicContract": "physics_engine::approximate::World::cast_ray_first",
      "dimensions": {
        "bodies": {
          "description": "static bodies in the world (doubling sizes)"
        }
      },
      "scalePoints": [
        {
          "bodies": 512
        },
        {
          "bodies": 1024
        },
        {
          "bodies": 2048
        },
        {
          "bodies": 4096
        },
        {
          "bodies": 8192
        },
        {
          "bodies": 16384
        }
      ],
      "metrics": [
        {
          "name": "tree-nodes",
          "unit": "nodes",
          "signal": "operation-count",
          "notes": "O(log n): one descent through the query tree.",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "logarithmic"
            }
          ]
        },
        {
          "name": "exact-tests",
          "unit": "tests",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "constant"
            }
          ],
          "notes": "Bodies tested exactly: independent of the world size."
        }
      ]
    },
