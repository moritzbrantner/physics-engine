              "dimension": "bodies",
              "bound": "logarithmic"
            }
          ],
          "notes": "Order-index insert and remove, O(log n), plus the amortized sort of out-of-order adds at compaction, O(log k) per add."
        },
        {
          "name": "worst-op-work",
          "unit": "work units",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
