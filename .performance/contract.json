{
  "schemaVersion": 2,
  "suite": "physics-engine",
  "description": "Rapier-oracle scenarios (speed is gated by the oracle, not here) and deterministic Big-O work contracts of the public API, measured by tests/work_complexity.rs with the test-only work-counters feature.",
  "scenarios": [
    {
      "id": "rapier-oracle",
      "kind": "journey",
      "description": "Every oracle scenario (oracle/src/lib.rs::all()) against Rapier: invariants plus the native and WASM speed gates, run by oracle/ and scripts/oracle-wasm.mjs. Speed is gated there, not here.",
      "dimensions": {},
      "metrics": [
        {
          "name": "tick-time",
          "unit": "microseconds",
          "direction": "lower",
          "signal": "wall-clock",
          "blocking": false
        }
      ]
    }
  ],
  "operations": [
