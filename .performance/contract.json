  "operations": [
    {
      "id": "ray-first",
      "description": "World::cast_ray_first, short rays in a town of unit boxes on a 2 m grid (constant density); 64 queries per point, per-query averages.",
      "publicContract": "physics_engine::approximate::World::cast_ray_first",
      "dimensions": {
        "log2Bodies": {
          "description": "log2 of the boxes in the town"
        }
      },
      "scalePoints": [
        {
          "log2Bodies": 9
        },
        {
          "log2Bodies": 10
        },
        {
          "log2Bodies": 11
        },
        {
          "log2Bodies": 12
        },
        {
          "log2Bodies": 13
        },
        {
          "log2Bodies": 14
        }
      ],
      "metrics": [
        {
          "name": "tree-nodes",
          "unit": "nodes",
          "signal": "operation-count",
          "budget": {
            "max": 32
          },
          "notes": "O(log n). Tree nodes grow with log n but coding-tooling has no logarithmic bound and its linear marginal-rate test is too strict for integer tree depths, so the class is held by a budget: a linear scan or a lost tree would exceed it by orders of magnitude at the largest town."
        },
        {
          "name": "exact-tests",
          "unit": "tests",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "log2Bodies",
              "bound": "constant"
            }
          ],
          "notes": "Bodies tested exactly: independent of the world size."
        }
      ]
    },
