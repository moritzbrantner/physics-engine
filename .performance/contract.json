{
  "schemaVersion": 2,
  "suite": "physics-engine",
  "description": "Rapier-oracle scenarios (speed is gated by the oracle, not here) and deterministic Big-O work contracts of the public API, measured by tests/work_complexity.rs with the test-only work-counters feature.",
  "scenarios": [
    {
      "id": "static-queries",
      "kind": "journey",
      "description": "C1/C11/C12 static boxes, rays and overlaps; gated against Rapier by the oracle (oracle/, scripts/oracle-wasm.mjs).",
      "dimensions": {},
      "metrics": [
        {
          "name": "tick-time",
          "unit": "microseconds",
          "direction": "lower",
          "signal": "wall-clock",
          "blocking": false
        }
      ]
    },
