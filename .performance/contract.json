      "metrics": [
        {
          "name": "storage-shifts-per-op",
          "unit": "records",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "constant"
            }
          ],
          "notes": "Amortized O(1): a removal leaves a tombstone; a compaction moves every record once when tombstones reach half the records (and at the next step)."
        },
        {
          "name": "tree-inserts-per-op",
          "unit": "leaves",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "constant"
            }
          ],
          "notes": "Incremental tree inserts plus the amortized SAH rebuild (every n/2 inserts)."
