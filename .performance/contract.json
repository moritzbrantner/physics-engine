      "metrics": [
        {
          "name": "tree-nodes",
          "unit": "nodes",
          "signal": "operation-count",
          "notes": "O(m log n): every move's casts descend the tree. Density is held by the budget, not a class: node visits stay flat up to density 4 and then step up when characters start touching (2846, 2859, 2859, 3474), which no growth class describes.",
          "growth": [
            {
              "product": [
                {
                  "dimension": "characters",
                  "bound": "linear"
                },
                {
                  "dimension": "bodies",
                  "bound": "logarithmic"
                }
              ]
            }
          ],
          "budget": {
            "max": 16384
          }
        },
        {
          "name": "tree-nodes-per-character",
          "unit": "nodes",
          "signal": "operation-count",
          "notes": "O(log n) per character, independent of how many characters move.",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "logarithmic"
            },
            {
              "dimension": "characters",
              "bound": "constant"
            }
          ]
        },
        {
          "name": "exact-tests",
          "unit": "tests",
          "signal": "operation-count",
          "budget": {
            "max": 256
          },
          "growth": [
            {
              "dimension": "characters",
              "bound": "linear"
            }
          ],
          "notes": "Neighbour tests: linear in movers at fixed density. With density they grow faster than linear here (more slides per move when crowded), so density is held by a budget far below all-pairs (32 movers would be 1024 tests per cast)."
        }
      ]
