    {
      "id": "body-churn",
      "description": "BodyStorage::Ordered: 4n operations, each removing a body from the middle of the order and adding one after every body.",
      "dimensions": {
        "bodies": {
          "description": "boxes in the town"
        }
      },
      "scalePoints": [
        {
          "bodies": 512
        },
        {
          "bodies": 1024
        },
        {
          "bodies": 2048
        },
        {
          "bodies": 4096
        },
        {
          "bodies": 8192
        },
        {
          "bodies": 16384
        }
      ],
      "metrics": [
        {
          "name": "storage-shifts-per-op",
          "unit": "records",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "constant"
            }
          ],
          "notes": "Amortized O(1): a removal leaves a tombstone; a compaction moves every record once when tombstones reach half the records (and at the next step)."
        },
        {
          "name": "tree-inserts-per-op",
          "unit": "leaves",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "constant"
            }
          ],
          "notes": "Incremental tree inserts plus the amortized SAH rebuild (every n/2 inserts)."
        },
        {
          "name": "order-comparisons-per-op",
          "unit": "comparisons",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "logarithmic"
            }
          ],
          "notes": "Binary search for the insertion point."
        },
        {
          "name": "worst-op-work",
          "unit": "work units",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "linear"
            }
          ],
          "notes": "The removal that triggers a compaction, or a tree rebuild: O(n)."
        }
      ]
    },
