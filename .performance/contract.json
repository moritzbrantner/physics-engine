    {
      "id": "body-churn",
      "description": "256 operations of remove-a-body-from-the-middle-of-the-order plus add-a-new-keyed-body, in a town of n boxes; amortized values are totals divided by 256.",
      "publicContract": "physics_engine::approximate::World::{add_body, remove_body}",
      "dimensions": {
        "bodies": {
          "description": "boxes in the town"
        }
      },
      "scalePoints": [
        {
          "bodies": 512
        },
        {
          "bodies": 1024
        },
        {
          "bodies": 2048
        },
        {
          "bodies": 4096
        },
        {
          "bodies": 8192
        },
        {
          "bodies": 16384
        }
      ],
      "metrics": [
        {
          "name": "storage-shifts-per-op",
          "unit": "records",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "linear"
            }
          ],
          "notes": "Declared linear, not the O(log n) target: bodies are stored densely in key order, so inserting or removing in the middle moves the later records and their slot indices. Amortized O(log n) needs a storage change (see the PR)."
        },
        {
          "name": "tree-inserts-per-op",
          "unit": "leaves",
          "signal": "operation-count",
          "growth": [
            {
              "dimension": "bodies",
              "bound": "constant"
            }
          ],
          "notes": "Incremental tree inserts plus the amortized SAH rebuild (every n/2 inserts)."
        },
        {
          "name": "worst-op-work",
          "unit": "records",
          "signal": "operation-count",
          "budget": {
            "max": 32768
          },
          "notes": "Worst single operation: the storage shift above or a full tree rebuild, both O(n)."
        }
      ]
    },
