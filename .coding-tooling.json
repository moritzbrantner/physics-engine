{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": [
      "format:check",
      "lint",
      "build",
      "test",
      "test:instrumentation-neutrality"
    ],
    "standard": [
      "format:check",
      "lint",
      "build",
      "test",
      "test:instrumentation-neutrality"
    ],
    "performance": [
      "benchmark:smoke"
    ]
  },
  "capabilityCommands": {
    ".": {
      "benchmark:smoke": [
        "bash",
        "scripts/run-sandbox-performance.sh"
      ],
      "lint": [
        "cargo",
        "clippy",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "test:instrumentation-neutrality": [
        "node",
        "scripts/check-instrumentation-neutrality.mjs"
      ]
    },
    "demo-wasm": {
      "lint": [
        "cargo",
        "clippy",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ]
    }
  },
  "requiredCapabilities": [
    "format:check",
    "lint",
    "build",
    "test",
    "benchmark:smoke",
    "test:instrumentation-neutrality"
  ],
  "merge": {
    "authority": "hosted",
    "requiredChecks": [
      "validate"
    ]
  }
}
