{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "build", "test"],
    "standard": ["format:check", "lint", "build", "test"]
  },
  "capabilityCommands": {
    ".": {
      "lint": ["cargo", "clippy", "--all-targets", "--features", "checkpoints", "--", "-D", "warnings"],
      "test": ["cargo", "test", "--locked", "--features", "checkpoints"]
    },
    "demo-wasm": {
      "lint": ["cargo", "clippy", "--all-targets", "--", "-D", "warnings"]
    }
  },
  "requiredCapabilities": ["format:check", "lint", "build", "test"],
  "merge": {
    "authority": "hosted",
    "requiredChecks": ["validate"]
  }
}
