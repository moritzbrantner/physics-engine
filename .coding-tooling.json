{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": [
      "format:check",
      "lint",
      "build",
      "test"
    ],
    "standard": [
      "format:check",
      "lint",
      "build",
      "test"
    ]
  },
  "capabilityCommands": {
    ".": {
      "lint": [
        "cargo",
        "clippy",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--locked",
        "--",
        "-D",
        "warnings"
      ],
      "test": [
        "cargo",
        "test",
        "--workspace",
        "--locked",
        "--features",
        "physics-engine/checkpoints"
      ],
      "performance:work": [
        "bash",
        "scripts/collect-work-evidence.sh"
      ]
    }
  },
  "requiredCapabilities": [
    "format:check",
    "lint",
    "build",
    "test"
  ],
  "merge": {
    "authority": "hosted",
    "requiredChecks": [
      "merge-ready"
    ]
  }
}
