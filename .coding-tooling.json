{
  "schemaVersion": 1,
  "profile": "repository-foundation-v1",
  "tiers": {
    "fast": ["format:check", "lint", "build", "test"],
    "standard": ["format:check", "lint", "build", "test"],
    "performance": ["benchmark:smoke"]
  },
  "capabilityCommands": {
    ".": {
      "benchmark:smoke": ["bash", "scripts/run-sandbox-performance.sh"]
    }
  },
  "requiredCapabilities": ["format:check", "lint", "build", "test", "benchmark:smoke"],
  "merge": {
    "authority": "hosted",
    "requiredChecks": ["validate"]
  }
}
